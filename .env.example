# Set the real upstream API key here after copying this file to .env.
# Alternatively, export it in the shell that runs docker compose.
ANTHROPIC_API_KEY=

# Optional Agent SDK relay settings.
PUPPETLLM_AGENT_SDK_MODEL=claude-opus-5-5
PUPPETLLM_AGENT_SDK_CONCURRENCY=4
PUPPETLLM_AGENT_SDK_TIMEOUT=600
PUPPETLLM_AGENT_SDK_API_RETRIES=0
PUPPETLLM_AGENT_SDK_MAX_API_REQUESTS=1
PUPPETLLM_AGENT_SDK_STRUCTURED_RETRIES=1
PUPPETLLM_AGENT_SDK_MAX_TURNS=1
# high is the default; auto uses the SDK/model default, low reduces thinking depth.
PUPPETLLM_AGENT_SDK_EFFORT=high
# Optional output cap, including thinking and the JSON response envelope.
# PUPPETLLM_AGENT_SDK_MAX_OUTPUT_TOKENS=32768
PUPPETLLM_AGENT_SDK_IDLE_WARNING=120
PUPPETLLM_AGENT_SDK_MAX_BUFFER_BYTES=4194304
PUPPETLLM_AGENT_SDK_CACHE_TTL=5m
PUPPETLLM_AGENT_SDK_TARGET=https://api.anthropic.com
